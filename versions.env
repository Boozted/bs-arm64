# Pinned inputs. Proton/Wine/DXVK must match the Proton build the game runs on,
# because lsteamclient and wineopenxr talk to Proton's own unix-side libraries.

# Toolchain
LLVM_MINGW_VERSION=20260922

# Proton 11.0-2c (ARM64) as shipped on the Steam Frame, and its submodules
PROTON_TAG=proton-11.0-2c
WINE_COMMIT=dc26e61847081a1b5cb0733dc30feba6ee575482
DXVK_COMMIT=a6764047e587178283fcde4073ae6e1410af594f

# Built from source
OPENXR_SDK_TAG=release-1.1.45
ZLIB_VERSION=1.3.1
UNITY_MONO_COMMIT=75711b4363fa58f05f953b3f95400d4d61c0ca35

# Fetched on the user's machine by install/bs-arm64.sh (not redistributable)
UNITY_VERSION=6000.0.40f1
UNITY_CHANGESET=157d81624ddf
UNITY_OPENXR_VERSION=1.14.3
VCREDIST_URL=https://aka.ms/vs/17/release/vc_redist.arm64.exe
