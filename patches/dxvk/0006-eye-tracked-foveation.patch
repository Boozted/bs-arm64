+  void DxvkContext::writeFdm(FdmMap& map, bool gaze, const float* centers) {
+    const auto& p = m_fdm.params;
+    float inner = gaze ? p.gazeInner : p.inner;
+    float outer = gaze ? p.gazeOuter : p.outer;
+
+    auto density = [&] (float u, float v, float cu, float cv) {
+      float du = u - cu, dv = v - cv;
+      float r = std::sqrt(du * du + dv * dv);
+      return r < inner ? 1.0f : r < outer ? p.mid : p.low;
+    };
+
+    for (uint32_t l = 0; l < m_fdm.layers; l++) {
+      for (uint32_t y = 0; y < m_fdm.height; y++) {
+        uint8_t* row = map.data + map.layout[l].offset + y * map.layout[l].rowPitch;
+
+        for (uint32_t x = 0; x < m_fdm.width; x++) {
+          float u = (float(x) + 0.5f) / float(m_fdm.width);
+          float v = (float(y) + 0.5f) / float(m_fdm.height);
+          float d;
+
+          if (p.uniform > 0.0f)
+            d = p.uniform;
+          else if (!gaze)
+            d = density(u, v, p.cx, p.cy);
+          else if (m_fdm.layers > 1u)
+            d = density(u, v, centers[2u * l], centers[2u * l + 1u]);
+          else
+            d = std::max(density(u, v, centers[0], centers[1]), density(u, v, centers[2], centers[3]));
+
+          uint8_t value = uint8_t(std::min(255.0f, d * 255.0f + 0.5f));
+          row[2u * x] = value;
+          row[2u * x + 1u] = value;
+        }
+      }
+    }
+
+    map.gaze = gaze;
 
-    auto data = reinterpret_cast<uint8_t*>(m_fdmImage->mapPtr(0));
+    for (uint32_t i = 0; i < 4u; i++)
+      map.key[i] = gaze ? int32_t(std::lround(centers[i] * float(4u * m_fdm.width))) : 0;
+  }
