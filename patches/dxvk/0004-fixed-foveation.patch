+  void DxvkContext::createFdm(uint32_t width, uint32_t height) {
+    auto envFloat = [] (const char* name, float def) {
+      std::string v = env::getEnvVar(name);
+      return v.empty() ? def : float(std::atof(v.c_str()));
+    };
+
+    const auto& props = m_device->properties().extFragmentDensityMap;
+    VkExtent2D texel = props.minFragmentDensityTexelSize;
+
+    if (!texel.width || !texel.height)
+      texel = { 32u, 32u };
+
+    uint32_t w = (width + texel.width - 1u) / texel.width;
+    uint32_t h = (height + texel.height - 1u) / texel.height;
+
+    float cx = envFloat("BS_ARM64_FDM_CX", 0.5f), cy = envFloat("BS_ARM64_FDM_CY", 0.59f);
+    float inner = envFloat("BS_ARM64_FDM_INNER", 0.30f), outer = envFloat("BS_ARM64_FDM_OUTER_R", 0.50f);
+    float mid = envFloat("BS_ARM64_FDM_MID", 0.5f), low = envFloat("BS_ARM64_FDM_OUTER", 0.25f);
+    float uniform = envFloat("BS_ARM64_FDM_UNIFORM", 0.0f);
+
+    // Turnip samples the density map on the CPU while recording the render pass, from the
+    // image's own memory: use a linear host-visible image and write it directly.
+    DxvkImageCreateInfo imageInfo = { };
+    imageInfo.type = VK_IMAGE_TYPE_2D;
+    imageInfo.format = VK_FORMAT_R8G8_UNORM;
+    imageInfo.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.extent = { w, h, 1u };
+    imageInfo.numLayers = 1u;
+    imageInfo.mipLevels = 1u;
+    imageInfo.usage = VK_IMAGE_USAGE_FRAGMENT_DENSITY_MAP_BIT_EXT;
+    imageInfo.stages = VK_PIPELINE_STAGE_FRAGMENT_DENSITY_PROCESS_BIT_EXT;
+    imageInfo.access = VK_ACCESS_FRAGMENT_DENSITY_MAP_READ_BIT_EXT;
+    imageInfo.tiling = VK_IMAGE_TILING_LINEAR;
+    imageInfo.layout = VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_PREINITIALIZED;
+    imageInfo.debugName = "FDM";
+
+    m_fdmImage = m_device->createImage(imageInfo,
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+
+    auto vk = m_device->vkd();
+
+    VkImageSubresource subresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u };
+    VkSubresourceLayout layout = { };
+    vk->vkGetImageSubresourceLayout(vk->device(), m_fdmImage->handle(), &subresource, &layout);
+
+    auto data = reinterpret_cast<uint8_t*>(m_fdmImage->mapPtr(0));
+
+    if (!data) {
+      Logger::err("FDM: image not host-visible");
+      m_fdmImage = nullptr;
+      return;
+    }
+
+    uint32_t full = 0u;
+
+    for (uint32_t y = 0; y < h; y++) {
+      for (uint32_t x = 0; x < w; x++) {
+        float dx = (float(x) + 0.5f) / float(w) - cx;
+        float dy = (float(y) + 0.5f) / float(h) - cy;
+        float r = std::sqrt(dx * dx + dy * dy);
+        float d = uniform > 0.0f ? uniform : r < inner ? 1.0f : r < outer ? mid : low;
+        uint8_t v = uint8_t(std::min(255.0f, d * 255.0f + 0.5f));
+        uint8_t* px = data + layout.offset + y * layout.rowPitch + 2u * x;
+        px[0] = v;
+        px[1] = v;
+        full += v == 255u;
+      }
+    }
+
+    // PREINITIALIZED keeps the data across the transition
+    VkImageMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_HOST_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_HOST_WRITE_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_FRAGMENT_DENSITY_PROCESS_BIT_EXT;
+    barrier.dstAccessMask = VK_ACCESS_2_FRAGMENT_DENSITY_MAP_READ_BIT_EXT;
+    barrier.oldLayout = VK_IMAGE_LAYOUT_PREINITIALIZED;
+    barrier.newLayout = VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = m_fdmImage->handle();
+    barrier.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, 1u };
+
+    VkDependencyInfo dep = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    dep.imageMemoryBarrierCount = 1u;
+    dep.pImageMemoryBarriers = &barrier;
+    m_cmd->cmdPipelineBarrier(DxvkCmdBuffer::InitBuffer, &dep);
+
+    VkImageViewCreateInfo viewInfo = { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    viewInfo.image = m_fdmImage->handle();
+    viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.format = VK_FORMAT_R8G8_UNORM;
+    viewInfo.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, 1u };
+
+    if (vk->vkCreateImageView(vk->device(), &viewInfo, nullptr, &m_fdmView))
+      m_fdmView = VK_NULL_HANDLE;
+
+    Logger::info(str::format("FDM: ", w, "x", h, " linear map (texel ", texel.width, "x", texel.height,
+      ", row pitch ", layout.rowPitch, ", ", full, " full-density texels) for ", width, "x", height,
+      uniform > 0.0f ? str::format(", uniform ", uniform) : std::string(), ", view ", m_fdmView ? "ok" : "failed"));
+  }
