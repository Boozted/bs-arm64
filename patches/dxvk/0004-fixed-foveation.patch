+  // bs-arm64 (BS_ARM64_FDM=1): fixed foveated rendering for the game's stereo eye pass, i.e. a square
+  // 2-layer render target of at least 1024 px. One fragment density map for both eyes: full density
+  // within BS_ARM64_FDM_INNER (0.30, fraction of the width) of BS_ARM64_FDM_CX/CY (0.5/0.59, the
+  // Frame's lens centers), BS_ARM64_FDM_MID (0.5) up to BS_ARM64_FDM_OUTER_R (0.50), then
+  // BS_ARM64_FDM_OUTER (0.25). Turnip rounds densities to 1, 1/2, 1/4, 1/8.
+  bool DxvkContext::fdmWanted(const DxvkFramebufferInfo& fbInfo) {
+    static const bool enabled = env::getEnvVar("BS_ARM64_FDM") == "1";
+
+    if (!enabled || !m_device->features().extFragmentDensityMap.fragmentDensityMap)
+      return false;
+
+    DxvkFramebufferSize size = fbInfo.size();
+
+    if (size.layers != 2 || size.width < 1024 || size.width != size.height)
+      return false;
+
+    if (!m_fdmView)
+      createFdm(size.width, size.height);
+
+    return m_fdmView != VK_NULL_HANDLE;
+  }
