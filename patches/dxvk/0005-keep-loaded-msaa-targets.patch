+  // A pass that loads a multisampled target we discarded would read stale memory. With Screen
+  // Distortion on, Unity keeps drawing on the scene after resolving it for the effect. Store that
+  // target from now on; at most one frame shows stale contents.
+  void DxvkContext::keepLoadedMultisampleTarget(const DxvkImage& image) {
+    if (image.info().sampleCount == VK_SAMPLE_COUNT_1_BIT)
+      return;
+
+    auto entry = m_msaaDiscards.find(image.handle());
+
+    if (entry == m_msaaDiscards.end() || entry->second != MsaaDiscard::Discarded)
+      return;
+
+    entry->second = MsaaDiscard::Keep;
+    Logger::info(str::format("MSAA: ", image.info().extent.width, "x", image.info().extent.height,
+      " target loaded after its store was discarded, storing it from now on"));
+  }
